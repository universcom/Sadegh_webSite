# ---------------------------------------------------------------------------
# Rahyaft Sanat — environment configuration
# Copy to ".env" and fill in real values. NEVER commit the real .env file.
# The installer (/install.php) writes this file for you.
# ---------------------------------------------------------------------------

# "production" hides errors from visitors; "local" shows them. Use production live.
APP_ENV=production
APP_DEBUG=false

# Absolute public URL, no trailing slash. Used for canonical URLs and sitemaps.
APP_URL=https://example.com

# Random 32+ character string. The installer generates one automatically.
APP_KEY=

# Default language and the languages the site is served in.
APP_DEFAULT_LOCALE=fa
APP_LOCALES=fa,en,ar

# --- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rahyaft
DB_USER=rahyaft_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Mail -------------------------------------------------------------------
# MAIL_MAILER: "smtp" (recommended) or "mail" (PHP mail(), no credentials).
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# MAIL_ENCRYPTION: tls (port 587), ssl (port 465), or empty for none.
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Rahyaft Sanat"

# Where new contact-form enquiries are announced. Blank disables notifications
# (enquiries are still always stored in the database).
MAIL_NOTIFY_TO=
